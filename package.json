{
  "name": "aide",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace-first AI-native coding shell prototype",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.17.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "tsc --noEmit && electron-vite build",
    "test": "bun run test:node",
    "test:node": "node ./node_modules/vitest/vitest.mjs run",
    "test:unit": "vitest run --exclude src/main/database.test.ts",
    "test:e2e": "bun run build && env -u WAYLAND_DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE -u SWAYSOCK XDG_SESSION_TYPE=x11 ELECTRON_OZONE_PLATFORM_HINT=x11 OZONE_PLATFORM=x11 xvfb-run -a playwright test --config=playwright.electron.config.ts",
    "test:watch": "vitest",
    "check": "biome check . --assist-enabled=false",
    "format": "biome format --write .",
    "doctor": "react-doctor .",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "test:native": "ELECTRON_RUN_AS_NODE=1 electron -e \"require('node-pty')\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.202",
    "@anthropic-ai/sdk": "0.110.0",
    "@git-diff-view/react": "^0.1.3",
    "@git-diff-view/shiki": "^0.1.3",
    "@gravity-ui/icons": "^2.18.0",
    "@heroui-pro/react": "^1.0.0-beta.1",
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@number-flow/react": ">=0.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel": ">=8.6.0",
    "embla-carousel-react": ">=8.6.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "motion": ">=12.12.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-aria-components": ">=1.17.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": ">=4.10.0",
    "recharts": ">=2.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": ">=3.2.0",
    "tailwindcss": "^4.2.2",
    "vscode-material-icons": "^0.1.1",
    "xterm": "^5.3.0",
    "zod": "4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@electron/rebuild": "4.1.0",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.0.0",
    "electron-vite": "5.0.0",
    "react-doctor": "0.7.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "@heroui-pro/react",
    "electron",
    "node-pty"
  ]
}
