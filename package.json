{
  "name": "aide",
  "version": "0.0.3",
  "private": true,
  "description": "Workspace-first AI-native coding shell prototype",
  "author": "Quantic Studios",
  "desktopName": "aIDE",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.17.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "tsc --noEmit && electron-vite build && node scripts/assert-main-runtime-import.mjs",
    "test": "bun run test:node",
    "test:node": "node ./node_modules/vitest/vitest.mjs run",
    "test:unit": "vitest run --exclude src/main/database.test.ts",
    "test:e2e": "bun run build && env -u WAYLAND_DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE -u SWAYSOCK XDG_SESSION_TYPE=x11 ELECTRON_OZONE_PLATFORM_HINT=x11 OZONE_PLATFORM=x11 xvfb-run -a playwright test --config=playwright.electron.config.ts",
    "test:watch": "vitest",
    "test:dependency-policy": "node --test scripts/check-dependency-policy.node-test.mjs",
    "test:packaging": "node --test scripts/desktop-packaging.node-test.mjs scripts/linux-ota-upgrade-drill.node-test.mjs scripts/release-assembly.node-test.mjs scripts/publish-ota-release.node-test.mjs scripts/release-workflows.node-test.mjs scripts/validate-packaged-update-config.node-test.mjs scripts/write-updater-metadata.node-test.mjs",
    "test:ota-health": "node ./node_modules/vitest/vitest.mjs run --config workers/ota-health/vitest.config.ts && node --test scripts/check-ota-health-gate.node-test.mjs workers/ota-health/migrations/0001_ota_health.node-test.mjs && WRANGLER_SEND_METRICS=false bunx wrangler deploy --dry-run --config workers/ota-health/wrangler.jsonc",
    "check": "biome check . --assist-enabled=false",
    "check:bundle": "node scripts/renderer-bundle-budget.mjs out/renderer",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "format": "biome format --write .",
    "doctor": "react-doctor .",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "test:native": "ELECTRON_RUN_AS_NODE=1 electron -e \"require('node-pty')\"",
    "package:checksums": "node scripts/write-checksums.mjs dist",
    "package:linux": "node scripts/package-linux.mjs",
    "install:linux": "node scripts/install-linux.mjs",
    "test:ota-linux-upgrade": "node scripts/linux-ota-upgrade-drill.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "package:mac:x64": "bun run package:mac -- --x64",
    "package:mac:arm64": "bun run package:mac -- --arm64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@anthropic-ai/sdk": "0.110.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@git-diff-view/react": "0.1.6",
    "@git-diff-view/shiki": "0.1.6",
    "@gravity-ui/icons": "2.20.0",
    "@heroui-pro/react": "1.0.0-beta.6",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@monaco-editor/react": "4.7.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@number-flow/react": "0.6.1",
    "@tailwindcss/vite": "4.3.2",
    "@xterm/addon-fit": "0.11.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron-updater": "6.8.9",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.23.0",
    "monaco-editor": "0.55.1",
    "motion": "12.42.2",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.1",
    "recharts": "3.9.2",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.2",
    "vscode-material-icons": "0.1.1",
    "xterm": "5.3.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@electron/rebuild": "4.1.0",
    "@iarna/toml": "2.2.5",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react-doctor": "0.7.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "hono": "4.12.25",
    "ip-address": "10.3.1",
    "picomatch": "4.0.4",
    "postcss": "8.5.19",
    "sharp": "0.35.4",
    "tar": "7.5.21"
  },
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "build": {
    "appId": "studio.quantic.aide",
    "productName": "aIDE",
    "icon": "build/icon.png",
    "executableName": "aide",
    "artifactName": "Aide-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    }
  }
}
